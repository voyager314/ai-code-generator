FROM node:20-alpine
WORKDIR /app
COPY package*.json yarn.lock* pnpm-lock.yaml* bun.lockb* ./
RUN corepack enable 2>/dev/null; \
    if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; \
    elif [ -f yarn.lock ]; then yarn install --frozen-lockfile; \
    elif [ -f bun.lockb ]; then bun install --frozen-lockfile; \
    else npm ci; fi
COPY . .
RUN if grep -q '"build"' package.json 2>/dev/null; then \
      if [ -f pnpm-lock.yaml ]; then pnpm run build; \
      elif [ -f yarn.lock ]; then yarn build; \
      elif [ -f bun.lockb ]; then bun run build; \
      else npm run build; fi; \
    fi
EXPOSE 3000
CMD if [ -f pnpm-lock.yaml ]; then pnpm start; \
    elif [ -f yarn.lock ]; then yarn start; \
    elif [ -f bun.lockb ]; then bun start; \
    else npm start; fi
